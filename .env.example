# Local dev: a local Postgres works fine.
# Deployed on Vercel: this MUST be a hosted Postgres reachable over the
# internet (e.g. Neon, free tier) — Vercel's servers can't reach a
# database running on your own laptop.
DATABASE_URL=postgres://localhost:5432/nemat

# Geoapify key for customer map tiles and nearby cafe search
GEOAPIFY_API_KEY=

# Serply server-side key for Google Maps cafe matches and Google Images
SERPLY_API_KEY=
